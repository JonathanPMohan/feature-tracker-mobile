{
  // Settings for every environment. appsettings.{Environment}.json is loaded
  // after this file and overrides it. (.NET's JSON settings files allow
  // comments like this one; plain JSON doesn't.)
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF Core logs every SQL statement at "Information". Outside
      // Development, keep it to warnings and errors (B6).
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
