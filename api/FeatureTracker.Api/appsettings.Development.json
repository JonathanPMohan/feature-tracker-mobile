{
  // Development only: loaded when ASPNETCORE_ENVIRONMENT is "Development"
  // (launchSettings.json sets it for `dotnet run`).
  "ConnectionStrings": {
    // The Docker database from docker-compose.yml (decision B).
    // LOCAL-ONLY PASSWORD: the container listens only on this Mac
    // (127.0.0.1:5433), so this protects nothing reachable from outside.
    // Real secrets never go in this repo; they'd go in `dotnet user-secrets`.
    // Timeout=5: give up connecting after 5 seconds, so /health answers 503
    // quickly when the database is down (B8). Npgsql's default is 15.
    "Default": "Host=localhost;Port=5433;Database=feature_tracker;Username=postgres;Password=postgres;Timeout=5"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // B6: show every SQL statement EF Core sends, so you can see the SQL
      // each LINQ query becomes. Parameter values show as placeholders.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
