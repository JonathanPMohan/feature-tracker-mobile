{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format api/FeatureTracker.slnx --verify-no-changes:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(npm test:*)",
      "Bash(npm run test)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(dotnet add:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet tool:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(npm run test:watch:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(gh:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Edit(~/Desktop/projects/feature-request-tracker/**)",
      "Write(~/Desktop/projects/feature-request-tracker/**)",
      "NotebookEdit(~/Desktop/projects/feature-request-tracker/**)"
    ]
  }
}
